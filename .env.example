# okf-kb 源凭证模板 — 复制为 .env(仓库根)并 chmod 600;.env 已 gitignore
# 凭证属源系统不属库 → 多库共享一份;BM 凭证不落此(secret-vault 自管)
# fetch.py 按自身路径定位本文件(tools/sources/<源>/fetch.py → 仓库根)

# Confluence(Server, PAT 只读最小权限)
CF_BASE_URL=http://wiki.wangankeji.cn
CF_TOKEN=<confluence-personal-access-token>

# Nextcloud(WebDAV,只读账号)
NC_BASE_URL=https://nc.example.com
NC_USER=<账号>
NC_PASSWORD=<密码>
