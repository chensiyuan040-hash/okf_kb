# .env — 凭据唯一落点(AD-10 白名单;0600,不进容器,不进 git)。
# 复制为 .env 后 chmod 600,按部署期实测填写(Q1/Q2/Q3/Q6)。
# 读取优先序:进程环境变量 > 本文件。

# ── Confluence(认证形态待内网验证 Q1:Cloud 用 Bearer PAT;Server/DC 常见 Basic)──
CF_BASE_URL=https://confluence.example.internal
CF_TOKEN=
# CF_AUTH_MODE=pat            # pat | basic;basic 时用下面两个
# CF_USER=
# CF_PASSWORD=

# ── 禅道(Q2:REST v1,Token 请求头)──
ZT_BASE_URL=http://zentao.example.internal
ZT_TOKEN=

# ── Nextcloud(Q3:WebDAV,应用密码)──
NC_BASE_URL=https://nextcloud.example.internal
NC_USER=
NC_APP_PASSWORD=

# ── 平台周边设施(显式复用,凭据独立)──
TIKA_URL=http://platform-backend:9998          # Office/PDF → 文本
MM_URL=http://mattermost.example.internal      # 告警通道
MM_TOKEN=                                      # bot token(收件人 id 在 gate.yaml)

# ── 建图/归一所使用的模型(AD-5:端点跟随平台,key 用专用低权 key)──
# 模型端点/模型名/vault settings 引用见 vaults/<source>/.pi/settings.json;
# 这里只放 key 本体(settings.json 里用 taskModelApiKeyEnv 引用变量名,禁字面 key)。
OKF_MODEL_API_KEY=

# ── BM(零明文:口令绝不落这里;工作区由 secret-vault 管理)──
# OKF_BM_WORKSPACE 由 okf-secret-vault.sh unseal 后按需 export,不写死在本文件。
